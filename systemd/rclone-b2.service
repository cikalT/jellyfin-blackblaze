[Unit]
Description=rclone: mount Backblaze B2 read-only untuk Jellyfin
Documentation=https://rclone.org/commands/rclone_mount/
After=network-online.target
Wants=network-online.target

[Service]
# notify = systemd baru menganggap unit ini "started" setelah mount SIAP.
# Seluruh pengurutan boot (terutama docker-after-mount.conf) bergantung
# pada ini.
Type=notify
EnvironmentFile=/etc/jellyfin-b2/env

# Bersihkan sisa start sebelumnya. Dua hal, dan urutannya penting.
#
# 1. fusermount3 -uz adalah LAZY unmount: mount-nya lepas seketika, tapi
#    proses rclone-nya TIDAK ikut mati. Proses yatim itu tetap memegang
#    port RC 5572, sehingga start berikutnya mati dengan
#    "bind: address already in use" — dan pesan systemd yang muncul ke
#    pengguna cuma "control process exited with error code".
# 2. Karena itu prosesnya harus dibunuh eksplisit, bukan sekadar di-unmount.
#
# Pola 'rclone[ ]mount' memakai trik kurung siku supaya baris sh ini tidak
# cocok dengan dirinya sendiri — tanpa itu, sh membunuh dirinya sendiri.
ExecStartPre=-/bin/sh -c 'fusermount3 -uz ${MEDIA_MOUNT} 2>/dev/null; pkill -f "rclone[ ]mount .*${MEDIA_MOUNT}" 2>/dev/null; sleep 1; exit 0'

ExecStart=/usr/bin/rclone mount b2:${B2_BUCKET} ${MEDIA_MOUNT} \
  --config /etc/rclone/rclone.conf \
  --cache-dir ${VFS_CACHE_DIR} \
  --allow-other \
  --read-only \
  --uid ${JELLYFIN_UID} \
  --gid ${JELLYFIN_GID} \
  --umask 022 \
  --dir-cache-time ${DIR_CACHE_TIME} \
  --poll-interval 0 \
  --vfs-cache-mode full \
  --vfs-cache-max-size ${VFS_CACHE_MAX_SIZE} \
  --vfs-cache-max-age 72h \
  --vfs-read-chunk-size 16M \
  --vfs-read-chunk-size-limit 128M \
  --vfs-read-ahead 128M \
  --vfs-fast-fingerprint \
  --buffer-size 16M \
  --transfers 4 \
  --checkers 8 \
  --timeout 1h \
  --rc \
  --rc-addr ${RCLONE_RC_ADDR} \
  --rc-no-auth \
  --syslog \
  --log-level INFO

# fusermount3, bukan fusermount: paket yang dipasang bootstrap adalah fuse3,
# yang menyediakan fusermount3. Biner "fusermount" tanpa angka berasal dari
# paket fuse v2 dan tidak ada di sistem ini. Fallback disediakan supaya unit
# ini tetap jalan di distro yang hanya punya v2.
ExecStop=-/bin/sh -c 'fusermount3 -uz ${MEDIA_MOUNT} || fusermount -uz ${MEDIA_MOUNT} || umount -l ${MEDIA_MOUNT}'

# Jaring pengaman: apa pun cara unit ini berakhir — berhasil, gagal, atau
# dibunuh — mountpoint dibersihkan. Tanpa ini, satu kegagalan meninggalkan
# mount basi yang menggagalkan setiap start berikutnya.
ExecStopPost=-/bin/sh -c 'fusermount3 -uz ${MEDIA_MOUNT} 2>/dev/null; exit 0'

# rclone kadang butuh waktu menutup cache VFS. Default 90 detik terlalu
# lama untuk unit yang sering di-restart saat setup.
TimeoutStopSec=20

Restart=on-failure
RestartSec=10

# Server hanya punya RAM 2 GB. Tanpa batas ini, rclone dan Jellyfin bisa
# saling mendorong ke OOM killer.
MemoryMax=512M

[Install]
WantedBy=multi-user.target
