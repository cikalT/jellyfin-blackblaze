# Salin file ini jadi `.env` lalu isi. `.env` tidak pernah di-commit.
#   cp .env.example .env && nano .env

# ─── Backblaze B2 ────────────────────────────────────────────────────────────
# Buat application key yang DIBATASI ke satu bucket, dengan kapabilitas
# listBuckets, listFiles, readFiles saja. Server tidak pernah menulis ke B2.
#
# B2_KEY_ID adalah "applicationKeyId" — string yang muncul BERSAMA key saat
# kamu membuatnya. BUKAN master Account ID di halaman akun. Salah satu ini
# adalah penyebab paling umum error 401 dari B2.
B2_KEY_ID=
B2_APPLICATION_KEY=
# Nama bucket, bukan bucket ID. Yang kamu ketik saat membuat bucket,
# mis. "media-saya" — bukan string heksadesimal panjang.
B2_BUCKET=

# ─── Mount rclone ────────────────────────────────────────────────────────────
MEDIA_MOUNT=/srv/media
VFS_CACHE_DIR=/var/cache/rclone
# Batas keras. Disk hanya 40 GB — jangan dinaikkan tanpa menghitung ulang
# anggaran disk di bagian 9 spec.
VFS_CACHE_MAX_SIZE=10G
# 1 jam. Inilah yang membuat deteksi file baru bawaan Jellyfin berfungsi.
# Menaikkannya berarti file baru tidak akan muncul otomatis.
DIR_CACHE_TIME=1h
# JANGAN diberi awalan RCLONE_. rclone memperlakukan setiap variabel
# lingkungan berawalan RCLONE_ sebagai flag; RCLONE_RC_ADDR akan menumpuk
# dengan --rc-addr di command line menjadi dua alamat identik, dan rclone
# mati dengan "bind: address already in use" di port yang jelas-jelas bebas.
RC_ADDR=127.0.0.1:5572

# ─── Jellyfin ────────────────────────────────────────────────────────────────
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11.11
# HARUS sama dengan WG_SERVER_IP di bawah. Jellyfin hanya mendengar di
# interface WireGuard, jadi satu-satunya cara menjangkaunya adalah dari
# dalam tunnel. Mengubah ini ke 0.0.0.0 mengekspos Jellyfin ke internet.
JELLYFIN_BIND=10.8.0.1
JELLYFIN_PORT=8096
JELLYFIN_MEM_LIMIT=1200m
JELLYFIN_UID=1000
JELLYFIN_GID=1000
JELLYFIN_DATA=/opt/jellyfin
TZ=Asia/Jakarta

# Diisi SETELAH wizard awal Jellyfin selesai:
# Dashboard -> Advanced -> API Keys -> New API Key.
# Dipakai refresh-library.sh dan healthcheck.sh. Boleh kosong sampai saat itu.
JELLYFIN_API_KEY=

# URL yang diumumkan ke client. Karena alamat WireGuard tetap, ini bisa
# diisi sejak awal dan tidak pernah berubah.
JELLYFIN_PUBLISHED_URL=http://10.8.0.1:8096

# ─── WireGuard ───────────────────────────────────────────────────────────────
WG_INTERFACE=wg0
WG_PORT=51820
WG_SUBNET=10.8.0.0/24
# Alamat VPS di dalam tunnel. Inilah yang kamu ketik di app Jellyfin.
WG_SERVER_IP=10.8.0.1
# IP PUBLIK VPS Tencent — dipakai client untuk mendial masuk.
# Cek dengan: curl -s ifconfig.me
WG_ENDPOINT=
WG_CLIENT_DIR=/etc/wireguard/clients

# ─── Kuota bandwidth ─────────────────────────────────────────────────────────
MONTHLY_QUOTA_GB=512
QUOTA_WARN_PERCENT=80
# Interface yang dipantau vnstat. Cek dengan: ip -o -4 route show to default
NET_INTERFACE=eth0
